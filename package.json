{
  "name": "kindernewgenz-monorepo",
  "private": true,
  "workspaces": ["backend"],
  "scripts": {
    "dev": "bun --env-file backend/.env --cwd backend --hot src/server.ts",
    "test": "bun --env-file backend/.env --cwd backend test",
    "typecheck": "bun --env-file backend/.env --cwd backend tsc --noEmit",
    "format": "bun --env-file backend/.env --cwd backend prettier --check src tests",
    "db:generate": "bun --env-file backend/.env --cwd backend drizzle-kit generate",
    "db:migrate": "bun --env-file backend/.env --cwd backend drizzle-kit migrate",
    "db:backup": "bun --cwd backend --env-file .env scripts/db-backup.ts",
    "db:restore": "bun --cwd backend --env-file .env scripts/db-restore.ts",
    "seed:sysadmin": "bun --env-file backend/.env --cwd backend scripts/seed-sysadmin.ts"
  }
}
