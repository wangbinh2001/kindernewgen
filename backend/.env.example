# Runtime DB
DATABASE_URL="postgres://newgen_app:newgen_app_dev@localhost:5433/kindernewgenz"

# Migration DB
MIGRATION_DATABASE_URL="postgres://postgres:postgres@localhost:5433/kindernewgenz"

# Required JWT signing secret; use a unique secret with at least 32 characters.
ACCESS_TOKEN_SECRET="replace-with-a-random-secret-at-least-32-characters"

# File storage. Use local only for development; use an S3-compatible provider in production.
STORAGE_PROVIDER="local"
STORAGE_BUCKET="kinder-files"
STORAGE_LOCAL_ROOT=".storage"
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_OTP_MAX="3"
RATE_LIMIT_WINDOW_SECONDS="60"
# Development-only token exposure for local SMS-provider testing. Keep false/unset in production.
# PASSWORD_RESET_EXPOSE_TOKEN="false"
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_ACCESS_KEY_ID="minioadmin"
# STORAGE_SECRET_ACCESS_KEY="replace-me"
